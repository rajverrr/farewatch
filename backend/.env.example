PORT=5001

# Amadeus Self-Service Flight API (Get free test keys at https://developers.amadeus.com)
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret
AMADEUS_ENV=test # 'test' for sandbox, 'production' for live GDS

# Optional Twilio WhatsApp API Credentials
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_WHATSAPP_NUMBER=+14155238886

# Optional Free WhatsApp via CallMeBot (https://www.callmebot.com)
# CALLMEBOT_API_KEY=your_callmebot_api_key

# Optional Telegram Bot Token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
